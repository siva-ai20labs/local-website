# Copy to .env and fill in. The app runs with everything blank (demo mode).

# Database (SQLite for local dev; use a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Claude API — AI website copy. Blank = deterministic fallback copy.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"   # or claude-sonnet-4-6 / claude-haiku-4-5

# Scraper — Apify (preferred; free tier, no paid Google key).
# Free token: https://console.apify.com/account/integrations
APIFY_API_TOKEN=""
APIFY_ACTOR_ID="compass~crawler-google-places"

# Scraper — Google Places API (optional fallback, used only if no Apify token).
GOOGLE_PLACES_API_KEY=""

# Blank Apify + blank Google = realistic demo seed data.
DEFAULT_LOCATION="Austin, TX"

# Protect the scrape endpoint (sent as `Authorization: Bearer <secret>`). Blank = open.
CRON_SECRET=""

# Auth — Google OAuth via Auth.js. Generate AUTH_SECRET with: npx auth secret
# GOOGLE_CLIENT_ID / SECRET come from Google Cloud Console → Credentials.
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only emails ending in this domain may sign in.
ALLOWED_EMAIL_DOMAIN="ai20labs.com"
